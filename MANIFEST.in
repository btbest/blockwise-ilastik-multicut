include LICENSE
include README.md
include environment.yml
include pyproject.toml
include *.py
recursive-include scripts *.py
recursive-include tests *.py *.ilp

prune libs
prune .github
prune .idea
prune __pycache__
prune *.egg-info

global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
